GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
WORKFLOW_TIME_ZONE=America/Vancouver
CONTENT_HISTORY_PATH=

# Keeps generation cost at $0 by blocking paid image/video API use.
ZERO_COST_MODE=true

# Keep free-only true unless you intentionally want image API charges.
FREE_IMAGE_GENERATION_ONLY=true
ALLOW_PAID_IMAGE_GENERATION=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# Free local video rendering. Requires ffmpeg installed on the runner.
# auto = generate MP4 only when the strategy chooses REEL_DRAFT
# always = also render a Reel draft from carousel slides
# disabled = never render video
VIDEO_GENERATION_MODE=auto
VIDEO_SECONDS_PER_SLIDE=2.6
VIDEO_FFMPEG_PRESET=veryfast
VIDEO_FFMPEG_CRF=20

# Optional compliant Reddit API research. Do not scrape Instagram/Reddit pages directly.
ENABLE_REDDIT_RESEARCH=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=thestatsandstacks-content-research/1.0

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DELIVERY_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=

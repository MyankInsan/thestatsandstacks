GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
WORKFLOW_TIME_ZONE=America/Vancouver
CONTENT_HISTORY_PATH=

# Keeps generation cost at $0 by blocking paid image/video API use.
ZERO_COST_MODE=true

# Keep free-only true unless you intentionally want image API charges.
FREE_IMAGE_GENERATION_ONLY=true
ALLOW_PAID_IMAGE_GENERATION=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# Optional $0 background image path.
# Use a Cloudflare Free account and keep the cap/model below unchanged unless you accept possible overage risk.
CLOUDFLARE_WORKERS_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_MAX_IMAGES_PER_RUN=8
CLOUDFLARE_ALLOW_PAID_OVERAGE=false

# Optional compliant Reddit API research. Do not scrape Instagram/Reddit pages directly.
ENABLE_REDDIT_RESEARCH=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=thestatsandstacks-content-research/1.0

# Optional comma-separated watchlist for the free hot-topic idea agents.
# Keep this to tickers only; the pipeline turns heat into education, not buy/sell calls.
HOT_TOPIC_WATCHLIST=SNDK,WDC,MU,NVDA,AVGO,AMD,PLTR,APP,HOOD,COIN,MSTR,SMCI,TSLA,SOFI,RKLB,IONQ

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DELIVERY_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=
